@{
    var chemin = Context.Request.Path;
    string? Actif(string prefixe) => prefixe == "/admin"
        ? (chemin == "/admin" || chemin == "/admin/" ? "page" : null)
        : (chemin.StartsWithSegments(prefixe) ? "page" : null);
    var superAdmin = User.IsInRole(Roles.SuperAdmin);
}
<ul class="admin-menu" role="list">
    <li><a href="/admin" aria-current="@Actif("/admin")"><icone nom="accueil" />Tableau de bord</a></li>
    <li><a href="/admin/terrains" aria-current="@Actif("/admin/terrains")"><icone nom="terrains" />Terrains</a></li>
    <li><a href="/admin/services" aria-current="@Actif("/admin/services")"><icone nom="services" />Services</a></li>
    <li><a href="/admin/localites" aria-current="@Actif("/admin/localites")"><icone nom="position" />Localités</a></li>
    <li><a href="/admin/parametres" aria-current="@Actif("/admin/parametres")"><icone nom="filtres" />Paramètres du site</a></li>
    @if (superAdmin)
    {
        <li><a href="/admin/utilisateurs" aria-current="@Actif("/admin/utilisateurs")"><icone nom="accompagnement" />Utilisateurs</a></li>
    }
    <li><a href="/admin/journal" aria-current="@Actif("/admin/journal")"><icone nom="document" />Journal</a></li>
</ul>
<ul class="admin-menu admin-menu--secondaire" role="list">
    <li><a href="/admin/mot-de-passe" aria-current="@Actif("/admin/mot-de-passe")"><icone nom="bouclier" />Mon mot de passe</a></li>
    <li data-installer-conteneur hidden><button type="button" data-installer-admin><icone nom="telephone" />Installer l'application</button></li>
    <li><a href="/" target="_blank" rel="noopener"><icone nom="partager" />Voir le site</a></li>
    <li>
        <form method="post" action="/admin/deconnexion" asp-antiforgery="true">
            <button type="submit"><icone nom="fermer" />Se déconnecter</button>
        </form>
    </li>
</ul>
