@using System.Security.Claims
@inject Yakkomom.Services.Interfaces.IParametreSiteService ParametresSite
@inject Yakkomom.Stockage.IStorageService Stockage
@{
    var parametresSite = await ParametresSite.ObtenirAsync();
    var cleLogo = parametresSite.CleLogo;
    var nomAdmin = $"{parametresSite.NomSite} Admin";
    var urlLogo = cleLogo is null ? Assets["img/logo.svg"] : Stockage.UrlImage(cleLogo, 128);
    var sansNavigation = ViewData["SansNavigation"] is true;
    var titre = ViewData["Title"] as string ?? "Administration";
    var nom = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity?.Name;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow">
    <title>@titre · @nomAdmin</title>
    @* Barre d'état du téléphone de la couleur de l'en-tête (comme le site public) *@
    <meta name="theme-color" content="#FBF7F0" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#121A15" media="(prefers-color-scheme: dark)">
    <meta name="color-scheme" content="light dark">
    <link rel="preload" href="@Assets["fonts/fraunces-latin.woff2"]" as="font" type="font/woff2" crossorigin>
    <style>
        @@font-face{font-family:"Fraunces";src:url("@Assets["fonts/fraunces-latin.woff2"]") format("woff2");font-weight:100 900;font-style:normal;font-display:swap}
    </style>
    @* <!script> : empêche le tag helper ImportMap d'ASP.NET de remplacer notre import map par la sienne (vide ici). *@
    <!script type="importmap" nonce="@Context.NonceCsp()">@Html.Raw(Assets.ImportMap(inclureAdmin: true))</!script>
    <link rel="stylesheet" href="@Assets["css/site.css"]">
    <link rel="stylesheet" href="@Assets["css/admin.css"]">
    <link rel="icon" href="@Assets["img/logo.svg"]" type="image/svg+xml">
    @* Application installable « Yakkomom Admin » (portée /admin, distincte de l'application publique) *@
    <link rel="manifest" href="/admin/manifest.webmanifest">
    <link rel="apple-touch-icon" href="@Assets["img/icones/admin-apple-touch-icon.png"]">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="@nomAdmin">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="admin @(sansNavigation ? "admin--seul" : null)">
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>

    <header class="admin-entete">
        <a class="logo" href="@(sansNavigation ? "/" : "/admin")">
            <img class="logo__marque" src="@urlLogo" alt="" width="28" height="28">
            <span>@LogoTexte.Html(parametresSite.NomSite)</span>
            <span class="admin-entete__badge">Admin</span>
        </a>
        @if (!sansNavigation && User.Identity?.IsAuthenticated == true)
        {
            <div class="admin-entete__compte bureau-seulement">
                <span class="muet">@nom</span>
                <form method="post" action="/admin/deconnexion" asp-antiforgery="true">
                    <button class="btn btn--discret btn--petit" type="submit">Se déconnecter</button>
                </form>
            </div>
        }
    </header>

    @if (sansNavigation)
    {
        <main id="contenu" class="admin-seul" tabindex="-1">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="admin-cadre">
            <nav class="admin-nav bureau-seulement" aria-label="Menu d'administration">
                <partial name="_NavAdmin" />
            </nav>
            <main id="contenu" class="admin-contenu" tabindex="-1">
                <partial name="_Messages" />
                @RenderBody()
            </main>
        </div>

        <nav class="admin-barre-bas mobile-seulement" aria-label="Menu d'administration">
            <a href="/admin" aria-current="@(Context.Request.Path == "/admin" ? "page" : null)"><icone nom="accueil" />Tableau</a>
            <a href="/admin/terrains" aria-current="@(Context.Request.Path.StartsWithSegments("/admin/terrains") ? "page" : null)"><icone nom="terrains" />Terrains</a>
            <a class="admin-barre-bas__ajout" href="/admin/terrains/nouveau"><span><icone nom="plus" /></span>Nouveau</a>
            <details class="admin-plus">
                <summary><icone nom="menu" />Plus</summary>
                <div class="admin-plus__feuille">
                    <partial name="_NavAdmin" />
                </div>
            </details>
        </nav>
    }

    <script type="module" src="@Assets["js/admin/application.js"]"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
